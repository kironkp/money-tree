SECRET_KEY=change-me
# DEBUG is implied by the absence of ON_HEROKU; never set ON_HEROKU locally.

# Local Postgres (optional — leave DB_USER unset to use SQLite in dev).
# DB_NAME=moneytree
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Owner account, read by `manage.py bootstrap_admin`.
DJANGO_SUPERUSER_USERNAME=kiron
DJANGO_SUPERUSER_EMAIL=kironkp@gmail.com
DJANGO_SUPERUSER_PASSWORD=pick-a-strong-one

# Alpaca — PAPER keys from https://app.alpaca.markets (free). Leave blank to run
# on the internal simulator with Yahoo/synthetic data only.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# v2 only. Live keys are separate from paper keys in the Alpaca dashboard.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Hard interlock: live orders are refused unless this is exactly 1 AND the
# mode in Settings is "live" (which itself requires typing ARM LIVE).
LIVE_TRADING_ARMED=0
LIVE_FLATTEN_ON_EXIT=0

# Coach (end-of-day Claude review). Dormant when blank.
ANTHROPIC_API_KEY=
# COACH_MODEL=claude-opus-5

# Sign-up is invite-only. Emails here can always sign up and become operators;
# everyone else needs an invite from Settings → People.
SIGNUP_ALLOWED_EMAILS=kironkp@gmail.com

# Email for password reset / verification. Leave EMAIL_HOST unset to print
# mail (and the action links) to the runserver console.
# Resend SMTP: EMAIL_HOST=smtp.resend.com EMAIL_HOST_USER=resend EMAIL_HOST_PASSWORD=re_...
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MoneyTree <onboarding@resend.dev>

# Google sign-in — dormant until both are set (callback /accounts/google/login/callback/).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
