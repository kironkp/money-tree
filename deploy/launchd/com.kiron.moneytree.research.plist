<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Nightly self-improvement at 02:10 PT: walk-forward every enabled strategy on
       trailing real bars, promote only proven out-of-sample improvements, journal it, then RESTART the
       agents so what was learned is what trades today. -->
  <key>Label</key><string>com.kiron.moneytree.research</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nice</string><string>-n</string><string>10</string>
    <string>/bin/bash</string>
    <string>/Users/kironkp/code/moneytree/deploy/nightly-research.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/kironkp/code/moneytree</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/Users/kironkp/code/moneytree/run/research.log</string>
  <key>StandardErrorPath</key><string>/Users/kironkp/code/moneytree/run/research.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/kironkp/.local/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
