<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The improvement review, once a day at 18:00 — after the 17:00 forex day
       roll and the 17:30 report, so it reads a closed day rather than half of
       one. It proposes; it never applies.
         cp deploy/launchd/com.kiron.moneytree.review-improve.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.kiron.moneytree.review-improve.plist -->
  <key>Label</key><string>com.kiron.moneytree.review-improve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kironkp/.local/bin/pipenv</string>
    <string>run</string><string>python</string><string>manage.py</string>
    <string>review</string><string>improvement</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/kironkp/code/moneytree</string>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/kironkp/code/moneytree/run/review-improve.log</string>
  <key>StandardErrorPath</key><string>/Users/kironkp/code/moneytree/run/review-improve.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/Users/kironkp/.local/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
</dict>
</plist>
